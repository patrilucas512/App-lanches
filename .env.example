# Copie para .env.local (ignorado pelo Git) e preencha. Nunca coloque valores neste arquivo.
# Use somente o projeto Supabase de desenvolvimento e chaves de teste. Veja o README.
# O modo dev não inicia com URL ou chave de produção, Stripe live ou modo production.

# --- Obrigatórias ---------------------------------------------------------------
# [pública] URL do projeto Supabase de desenvolvimento
NEXT_PUBLIC_SUPABASE_URL=
# [pública] Chave publishable (sb_publishable_...) do projeto de desenvolvimento
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [secreta] Chave secreta (sb_secret_...) do projeto de desenvolvimento; sem ela o login por senha falha
SUPABASE_SECRET_KEY=
# Ambiente de execução; use development no local (o modo dev exige)
MASTERAPP_ENVIRONMENT=

# --- Recomendadas no local ------------------------------------------------------
# [pública] Endereço do app; no local, http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# [secreta] Texto aleatório para assinar códigos do portal Minha Conta
CUSTOMER_PORTAL_OTP_SECRET=

# --- Opcionais: Stripe (use sempre test mode) -----------------------------------
# [secreta] Chave de teste (sk_test_...)
STRIPE_SECRET_KEY=
# [secreta] Segredo de webhook de teste (whsec_...)
STRIPE_WEBHOOK_SECRET=
# ID de preço de teste do plano Growth; usado se o plano não tiver preço no banco
STRIPE_GROWTH_MONTHLY_PRICE_ID=

# --- Opcionais: IA e WhatsApp ---------------------------------------------------
# [secreta] Chave da OpenAI separada para desenvolvimento
OPENAI_API_KEY=
# Modelo do atendente de IA; vazio usa o padrão do código
WHATSAPP_AI_MODEL=
# Telefones de teste separados por vírgula; fora de produção, envios para outros números são bloqueados
WHATSAPP_TEST_RECIPIENTS=

# --- Opcionais: webhooks e ajustes ----------------------------------------------
# [secreta] Valida webhooks do provedor fiscal
FISCAL_WEBHOOK_SECRET=
# [secreta] Valida webhooks do provedor de voz
VOICE_WEBHOOK_SECRET=
# [secreta] Sal do limite de envios do formulário de leads; vazio usa um valor padrão
SALES_CAPTURE_SALT=
# Modo do provedor fiscal; vazio equivale a teste, e production é bloqueado no modo dev
FISCAL_ENVIRONMENT=
# [pública] Versão exibida no app e nos logs; vazio mostra development
NEXT_PUBLIC_RELEASE_VERSION=

# --- Opcionais: workers (sem segredo, o worker responde 401/403 e não roda) ------
# [secreta] Segredo geral: reports, notifications, incidents, performance, customer-360, busca, automation, journeys, warehouse, transport e central-production
CRON_SECRET=
# [secreta] Automation e journeys; também é reserva de store-opening, catalog, capacity e franchise-finance
AUTOMATION_WORKER_SECRET=
# [secreta] Worker de relatórios
REPORT_WORKER_SECRET=
# [secreta] Worker de notificações
NOTIFICATION_WORKER_SECRET=
# [secreta] Worker de incidentes
INCIDENT_WORKER_SECRET=
# [secreta] Worker de gestão de desempenho
PERFORMANCE_WORKER_SECRET=
# [secreta] Worker do Cliente 360
CUSTOMER360_WORKER_SECRET=
# [secreta] Indexador da busca global
SEARCH_INDEXER_SECRET=
# [secreta] Worker de abertura de lojas
STORE_OPENING_WORKER_SECRET=
# [secreta] Worker de catálogo
CATALOG_WORKER_SECRET=
# [secreta] Worker de capacidade
CAPACITY_WORKER_SECRET=
# [secreta] Worker financeiro de franquias
FRANCHISE_FINANCE_WORKER_SECRET=
# [secreta] Worker de treinamentos
LEARNING_WORKER_SECRET=
# [secreta] Worker de planejamento de suprimentos
INTERNAL_WORKER_SECRET=
# [secreta] Worker de planejamento de equipe
WORKER_SHARED_SECRET=
# [secreta] Worker de integrações com marketplaces
MARKETPLACE_WORKER_TOKEN=

# --- Não preencha no local: deixe comentadas --------------------------------------
# [secreta] Reserva do portal Minha Conta e chave das edge functions; nunca a de produção
# SUPABASE_SERVICE_ROLE_KEY=
# Definidas pelo Supabase nas edge functions, não pelo app
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# Configurada nos secrets das edge functions: endereço público usado nos links
# PUBLIC_SITE_URL=
# Definidas pela ferramenta ou pela hospedagem
# NODE_ENV=
# CF_PAGES_COMMIT_SHA=
# VERCEL_GIT_COMMIT_SHA=
# CODEX_SANDBOX=
# WRANGLER_WRITE_LOGS=
# WRANGLER_LOG_PATH=
# MINIFLARE_REGISTRY_PATH=
# Usadas só por scripts de QA e carga, passadas no comando
# TEST_BASE_URL=
# TEST_ENVIRONMENT=
# TEST_PUBLIC_MENU_PATH=
# PRODUCTION_BASE_URL=
# SUPABASE_PROJECT_ID=
# PRODUCTION_SUPABASE_PROJECT_ID=
# LOAD_TEST_URL=
# LOAD_TEST_CONCURRENCY=
# LOAD_TEST_REQUESTS=
# LOAD_TEST_SCENARIO=
# ALLOW_PRODUCTION_LOAD_TEST=
# Definidas pelo GitHub Actions
# GITHUB_EVENT_NAME=
# VERSION=
# COMMIT=
# ACTOR=
